[
 {
  "id": "find_ohio_sps_wet_freeze",
  "question": "Which Ohio SPS test sections are in a wet-freeze climate?",
  "expected_tools": [
   "search_sections"
  ],
  "smoke": {
   "tool": "search_sections",
   "args": {
    "state": "OH",
    "gps_sps": "SPS",
    "climate_zone": "wet-freeze",
    "limit": 3
   },
   "assert": [
    {
     "path": "data_release",
     "op": "contains",
     "value": "SDR"
    },
    {
     "path": "sources",
     "op": "contains",
     "value": "Test section inventory"
    },
    {
     "path": "total_count",
     "op": ">=",
     "value": 1
    },
    {
     "path": "data.0.state",
     "op": "==",
     "value": "Ohio"
    },
    {
     "path": "data.0.gps_sps",
     "op": "==",
     "value": "SPS"
    }
   ]
  }
 },
 {
